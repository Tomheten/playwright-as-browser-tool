{
    "name": "playwright-as-browser",
    "version": "0.0.1",
    "private": true,
    "description": "For webinar",
    "license": "GPL-3.0",
    "author": "B.Medoshin",
    "scripts": {
        "runByAppend": "vite-node ./scenarios/run-by-append.ts",
        "playwright": "playwright",
        "dprint": "dprint",
        "start": "playwright test -c ./playwright.config.ts",
        "runChrome": "vite-node ./scenarios/run-chromium.ts",
        "simpleRun": "vite-node ./scenarios/simple-run.ts",
        "codeOnPage": "vite-node ./scenarios/run-code-on-page.ts",
        "record": "vite-node ./scenarios/record.ts",
        "record-other": "tsx ./scenarios/record-other.ts",
        "vuejs": "vite-node ./scripts/vue-js.ts",
        "change-response": "vite-node ./scenarios/change-http-response.ts",
        "env-info": "vite-node ./scenarios/get-env-info.ts",
        "lint-staged": "lint-staged",
        "cdp": "vite-node ./scenarios/cdp-functionality.ts",
        "code-gen": "vite-node ./scenarios/codegen-mode.ts"
    },
    "devDependencies": {
        "@playwright/test": "~1.61.1",
        "@types/node": "^24.0.0",
        "typescript": "6.0.3",
        "dprint": "0.55.1",
        "vite-node": "6.0.0",
        "lint-staged": "17.0.8",
        "wait-on": "9.0.10",
        "tsx": "4.23.13"
    },
    "engines": {
        "node": ">=24"
    },
    "lint-staged": {
        "*.(ts,js)": "dprint"
    }
}
